[Unit]
Description=Shadow Forge SCUM Query Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/shadow-forge-query
ExecStart=/usr/bin/node /opt/shadow-forge-query/server.js
Restart=always
RestartSec=3
EnvironmentFile=/opt/shadow-forge-query/.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/shadow-forge-query

[Install]
WantedBy=multi-user.target
