{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shadow-forge",
  "main": "./playtime-tracker.js",
  "compatibility_date": "2026-09-11",

  "observability": {
    "enabled": true
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "kv_namespaces": [
    {
      "binding": "KILLFEED_KV",
      "id": "da05a71a58e4439f87147dc7915df18d"
    }
  ]
}
